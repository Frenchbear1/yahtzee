rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/yahtzeeRooms/$(roomId);
    }

    function isRoomMember(roomId) {
      return signedIn()
        && request.auth.uid in get(roomPath(roomId)).data.member_ids;
    }

    function willBeRoomMember(roomId) {
      return signedIn()
        && request.auth.uid in getAfter(roomPath(roomId)).data.member_ids;
    }

    function isRoomHost(roomId) {
      return signedIn()
        && get(roomPath(roomId)).data.host_id == request.auth.uid;
    }

    function willBeRoomHost(roomId) {
      return signedIn()
        && getAfter(roomPath(roomId)).data.host_id == request.auth.uid;
    }

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function validProfile() {
        return request.resource.data.keys().hasOnly([
          'playerToken', 'displayName', 'email', 'updatedAt'
        ])
        && request.resource.data.playerToken is string
        && request.resource.data.playerToken.matches('^[a-f0-9]{64}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isOwner();
      allow create: if isOwner() && validProfile();
      allow update: if isOwner()
        && validProfile()
        && request.resource.data.playerToken == resource.data.playerToken;
      allow delete: if isOwner();

      // A signed-in player's score history is private to that Google account.
      // The app stores it below the profile so it can be restored on any device.
      match /yahtzee/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // A short code only resolves to a room id for authenticated players. All
    // room contents remain protected by membership checks below.
    match /yahtzeeRoomCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{4,8}$')
        && request.resource.data.keys().hasOnly(['room_id', 'host_id', 'created_at'])
        && request.resource.data.host_id == request.auth.uid
        && willBeRoomHost(request.resource.data.room_id);
      allow update: if false;
      allow delete: if signedIn() && resource.data.host_id == request.auth.uid;
    }

    match /yahtzeeRooms/{roomId} {
      function validRoom() {
        return request.resource.data.keys().hasOnly([
          'name', 'code', 'host_id', 'created_at', 'updated_at',
          'current_game_id', 'member_ids'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{4,8}$')
        && request.resource.data.host_id is string
        && request.resource.data.current_game_id is string
        && request.resource.data.member_ids is list
        && request.resource.data.member_ids.size() > 0
        && request.resource.data.member_ids.size() <= 12
        && request.resource.data.host_id in request.resource.data.member_ids;
      }

      function hostUpdate() {
        return resource.data.host_id == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'updated_at', 'current_game_id', 'member_ids'
          ]);
      }

      function selfJoin() {
        return !(request.auth.uid in resource.data.member_ids)
          && request.auth.uid in request.resource.data.member_ids
          && request.resource.data.member_ids.hasAll(resource.data.member_ids)
          && request.resource.data.member_ids.size() == resource.data.member_ids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'updated_at', 'member_ids'
          ]);
      }

      // A signed-in invite recipient learns this unguessable room id from the
      // short-code document, then reads metadata before atomically joining.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.member_ids;
      allow create: if signedIn()
        && validRoom()
        && request.resource.data.host_id == request.auth.uid
        && request.resource.data.member_ids == [request.auth.uid];
      allow update: if signedIn() && validRoom() && (hostUpdate() || selfJoin());
      allow delete: if signedIn() && resource.data.host_id == request.auth.uid;

      match /members/{memberId} {
        function validMember() {
          return request.resource.data.keys().hasOnly(['id', 'name', 'photo_url', 'last_seen'])
            && request.resource.data.id == memberId
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 32
            && (request.resource.data.photo_url == null || request.resource.data.photo_url is string);
        }

        allow read: if isRoomMember(roomId);
        allow create: if request.auth.uid == memberId
          && willBeRoomMember(roomId)
          && validMember();
        allow update: if request.auth.uid == memberId
          && isRoomMember(roomId)
          && validMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'photo_url', 'last_seen'
          ]);
        allow delete: if request.auth.uid == memberId || isRoomHost(roomId);
      }

      match /games/{gameId} {
        function validGame() {
          return request.resource.data.keys().hasOnly([
            'id', 'room_id', 'started_at', 'ended_at', 'updated_at', 'sheets'
          ])
          && request.resource.data.id == gameId
          && request.resource.data.room_id == roomId
          && request.resource.data.sheets is map;
        }

        function hostSheetRemoval() {
          let removedSheets = resource.data.sheets.keys().toSet().difference(request.resource.data.sheets.keys().toSet());
          return isRoomHost(roomId)
            && removedSheets.size() == 1
            && request.resource.data.sheets.keys().toSet().difference(resource.data.sheets.keys().toSet()).size() == 0
            && request.resource.data.sheets.diff(resource.data.sheets).affectedKeys().size() == 1
            && get(roomPath(roomId)).data.member_ids.toSet().hasAll(removedSheets)
            && !getAfter(roomPath(roomId)).data.member_ids.toSet().hasAny(removedSheets);
        }

        allow read: if isRoomMember(roomId);
        allow create: if willBeRoomHost(roomId) && validGame();
        allow update: if (isRoomMember(roomId) || willBeRoomMember(roomId))
          && validGame()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sheets', 'ended_at', 'updated_at'
          ])
          && (
            request.resource.data.sheets.diff(resource.data.sheets).affectedKeys().hasOnly([
              request.auth.uid
            ])
            || hostSheetRemoval()
          );
        allow delete: if isRoomHost(roomId);
      }
    }
  }
}
